---
import { url } from '../lib/url';
import { projects } from '../data/projects';

const here = Astro.url.pathname.replace(/\/$/, '');
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={url('')} aria-label="Tangobuilds home">
      <span class="mark" aria-hidden="true">T</span>
      <span class="word">Tango<b>builds</b></span>
    </a>
    <nav aria-label="Projects">
      {projects.map((p) => {
        const href = url(`projects/${p.slug}/`);
        const current = here === href.replace(/\/$/, '');
        return <a href={href} aria-current={current ? 'page' : undefined}>{p.name}</a>;
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--hdr-fg, var(--fg));
    transition: background-color .35s, border-color .35s, backdrop-filter .35s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: var(--hdr-bg, color-mix(in srgb, var(--ink-950) 72%, transparent));
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--hdr-line, color-mix(in srgb, var(--fg) 10%, transparent));
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .9rem; }
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; }
  .mark {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 8px;
    background: var(--tango); color: #0a0f1e;
    font-family: var(--display); font-weight: 800; font-size: 1.35rem; line-height: 1;
    transition: transform .5s var(--ease-out);
  }
  .logo:hover .mark { transform: rotate(-12deg) scale(1.06); }
  .word { font-family: var(--display); font-weight: 800; font-size: 1.35rem; letter-spacing: .03em; text-transform: uppercase; }
  .word b { color: var(--tango); font-weight: 800; }
  nav { display: flex; gap: .25rem; }
  nav a {
    position: relative; text-decoration: none; font-size: .9rem; font-weight: 500;
    padding: .45rem .75rem; opacity: .75; transition: opacity .2s;
  }
  nav a:hover, nav a[aria-current='page'] { opacity: 1; }
  nav a::after {
    content: ''; position: absolute; left: .75rem; right: .75rem; bottom: .2rem; height: 2px;
    background: var(--tango); transform: scaleX(0); transform-origin: left;
    transition: transform .35s var(--ease-out);
  }
  nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1); }
  @media (max-width: 640px) {
    .word { display: none; }
    nav a { padding: .45rem .5rem; font-size: .82rem; }
    nav a::after { left: .5rem; right: .5rem; }
  }
</style>
