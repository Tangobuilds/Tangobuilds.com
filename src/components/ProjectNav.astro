---
import { neighbours } from '../data/projects';
import { url } from '../lib/url';

interface Props { slug: string }
const { prev, next } = neighbours(Astro.props.slug);
---

<nav class="pnav" aria-label="More projects">
  <div class="wrap row">
    <a href={url(`projects/${prev.slug}/`)} class="prev">
      <small>← Previous</small>
      <span>{prev.name}</span>
    </a>
    <a href={url('')} class="all">All projects</a>
    <a href={url(`projects/${next.slug}/`)} class="next">
      <small>Next →</small>
      <span>{next.name}</span>
    </a>
  </div>
</nav>

<style>
  .pnav { border-top: 1px solid var(--ftr-line, var(--line)); padding-block: 2.5rem; }
  .row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
  a { text-decoration: none; display: flex; flex-direction: column; gap: .2rem; }
  .next { text-align: right; align-items: flex-end; }
  small { font-family: var(--mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; opacity: .7; }
  span { font-size: clamp(1.2rem, 3vw, 1.8rem); font-weight: 700; transition: transform .4s var(--ease-out); display: inline-block; }
  .prev:hover span { transform: translateX(-6px); }
  .next:hover span { transform: translateX(6px); }
  .all { font-size: .9rem; opacity: .75; border-bottom: 1px solid currentColor; padding-bottom: .1rem; }
  .all:hover { opacity: 1; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr 1fr; } .all { display: none; } }
</style>
