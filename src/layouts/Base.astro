---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import { url } from '../lib/url';
import '@fontsource/big-shoulders-display/600';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/ibm-plex-sans/400';
import '@fontsource/ibm-plex-sans/500';
import '@fontsource/ibm-plex-sans/600';
import '@fontsource/ibm-plex-mono/400';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page theme class on <body>; each themed page sets its own header colours through it. */
  theme?: string;
}

const { title, description, theme = 'theme-studio' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('assets/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b1020" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body class={theme}>
    <SiteHeader />
    <slot />
    <script>
      import { initMotion } from '../lib/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
