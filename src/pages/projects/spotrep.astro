---
import Base from '../../layouts/Base.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { url } from '../../lib/url';
import '@fontsource/stardos-stencil/700';
import '@fontsource/barlow/400';
import '@fontsource/barlow/500';
import '@fontsource/barlow-condensed/500';
import '@fontsource/barlow-condensed/700';
import '@fontsource/jetbrains-mono/500';

const salute = [
  ['S', 'Size', 'More than 300 vehicles, aircraft and weapons in the catalogue.'],
  ['A', 'Activity', 'A new daily challenge every day, plus practice, streak and drill modes.'],
  ['L', 'Location', 'Plays in any browser on phone or desktop. Nothing to install.'],
  ['U', 'Unit', 'Leaderboards by category, achievements and a rank that grows with you.'],
  ['T', 'Time', 'The faster you answer, the more points you score. Hints cost points.'],
  ['E', 'Equipment', 'A field guide to study between rounds, with its own separate photos.'],
];
const play = 'https://www.spotrep.net';
---

<Base title="Spotrep · Tangobuilds" description="Spotrep is a daily recognition game for military equipment. One photo, one clock, name the vehicle." theme="theme-spotrep">
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="copy">
          <p class="class">Daily challenge · Web · Phone</p>
          <h1 class="stamp">SPOTREP</h1>
          <p class="lead">One photo. One clock. Name the vehicle. A daily recognition game for anyone who can tell a T-72 from a T-90 at a glance, or wants to learn.</p>
          <div class="actions">
            <a class="btn btn-sr" href={play} target="_blank" rel="noopener" data-magnetic>Play free <span class="arrow">↗</span></a>
            <a class="btn btn-ghost" href="#report">What's inside</a>
          </div>
        </div>
        <div class="scope" transition:name="visual-spotrep" aria-hidden="true">
          <img src={url('assets/spotrep-leopard2.webp')} alt="" width="1600" height="1067" />
          <span class="ring"></span>
          <span class="h"></span><span class="v"></span>
          <span class="ticks"></span>
          <span class="timer" data-timer>00:15</span>
          <span class="q">Identify target</span>
          <span class="ref">Round 3 / 10</span>
        </div>
      </div>
    </section>

    <section class="report" id="report">
      <div class="wrap">
        <div class="sheet" data-reveal>
          <header>
            <h2>Spot report</h2>
            <span>What you get · SALUTE format</span>
          </header>
          <dl>
            {salute.map(([l, k, v], i) => (
              <div class="line" data-reveal="left" data-delay={i * 90}>
                <dt>{l}</dt>
                <dd class="k">{k}</dd>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="tiers">
      <div class="wrap tier-grid">
        <div class="tier" data-reveal>
          <h3>Free</h3>
          <ul><li>The daily challenge</li><li>5 practice games a day</li><li>Play as a guest, keep progress with email</li></ul>
          <a class="btn btn-ghost" href={play} target="_blank" rel="noopener">Play now <span class="arrow">↗</span></a>
        </div>
        <div class="tier pro" data-reveal data-delay="120">
          <h3>Pro</h3>
          <ul><li>Unlimited practice</li><li>Every mode</li><li>Supports development</li></ul>
          <a class="btn btn-sr" href={play} target="_blank" rel="noopener">Get Pro <span class="arrow">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <ProjectNav slug="spotrep" />
  <SiteFooter credit="Photo: Leopard 2A7, U.S. Army (105th MPAD), public domain, via Wikimedia Commons." />
</Base>

<script>
  // The scope timer counts down from 15 and starts over, like a round.
  function startTimer() {
    const el = document.querySelector<HTMLElement>('[data-timer]');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let s = 15;
    const id = setInterval(() => {
      s = s <= 0 ? 15 : s - 1;
      el.textContent = `00:${String(s).padStart(2, '0')}`;
      el.classList.toggle('low', s <= 5);
    }, 1000);
    document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });
  }
  document.addEventListener('astro:page-load', startTimer);
</script>

<style>
  :global(body.theme-spotrep) {
    --page-bg: #2b3022; --page-fg: #ece3c8;
    --hdr-fg: #ece3c8; --hdr-bg: rgba(31,35,24,.82); --hdr-line: rgba(200,184,138,.25);
    --ftr-line: rgba(200,184,138,.22); --ftr-fg: #a9a083; --ftr-strong: #ece3c8;
    --sr-tan: #c8b88a; --sr-deep: #1c2016; --sr-amber: #ffb547; --sr-red: #ff6b55; --sr-paper: #e6dcc0;
    --stencil: 'Stardos Stencil', Impact, sans-serif;
    --cond: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-family: 'Barlow', system-ui, sans-serif;
    background-image: radial-gradient(rgba(200,184,138,.08) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .btn-sr { background: var(--sr-amber); border-color: var(--sr-amber); color: #1f1a0c; font-family: var(--cond); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border-radius: 3px; }
  .btn-sr:hover { background: #ffc875; }
  .btn-ghost { border-radius: 3px; font-family: var(--cond); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

  .hero { padding-block: 8rem 5rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 3rem; align-items: center; }
  @media (max-width: 880px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .class { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .8rem; color: var(--sr-amber); letter-spacing: .12em; text-transform: uppercase; margin: 0; }
  h1 { font-family: var(--stencil); font-weight: 700; font-size: clamp(4rem, 13vw, 8.5rem); line-height: .9; letter-spacing: .04em; color: var(--sr-tan); margin: .5rem 0 1.25rem; }
  .stamp { animation: stamp .7s cubic-bezier(.2, 1.6, .4, 1) .15s both; }
  @keyframes stamp { from { opacity: 0; transform: scale(1.6) rotate(-4deg); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  .lead { font-size: 1.2rem; max-width: 32rem; margin: 0 0 2rem; }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap; }

  .scope { position: relative; aspect-ratio: 4 / 3; max-width: 100%; border: 2px solid var(--sr-tan); overflow: hidden; background: var(--sr-deep); border-radius: 4px; }
  .scope img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.6) contrast(1.05); animation: zoom 18s ease-in-out infinite alternate; }
  @keyframes zoom { from { transform: scale(1.05); } to { transform: scale(1.3) translate(-3%, 2%); } }
  .scope::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, transparent 38%, rgba(10,12,8,.75) 72%); pointer-events: none; }
  .ring { position: absolute; z-index: 1; left: 50%; top: 50%; width: 38%; aspect-ratio: 1; border: 1.5px solid rgba(230,220,192,.9); border-radius: 50%; transform: translate(-50%, -50%); animation: lock 2.4s var(--ease-out) .4s both; }
  @keyframes lock { from { width: 90%; opacity: 0; } to { width: 38%; opacity: 1; } }
  .h, .v { position: absolute; z-index: 1; background: rgba(230,220,192,.85); }
  .h { left: 0; right: 0; top: 50%; height: 1.5px; transform-origin: left; animation: drawx 1s var(--ease-out) .3s both; }
  .v { top: 0; bottom: 0; left: 50%; width: 1.5px; transform-origin: top; animation: drawy 1s var(--ease-out) .45s both; }
  @keyframes drawx { from { transform: scaleX(0); } }
  @keyframes drawy { from { transform: scaleY(0); } }
  .ticks { position: absolute; z-index: 1; left: 10%; right: 10%; top: calc(50% + 6px); height: 8px; background: repeating-linear-gradient(90deg, rgba(230,220,192,.8) 0 1.5px, transparent 1.5px 9%); }
  .timer { position: absolute; z-index: 2; top: .9rem; right: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 1rem; color: var(--sr-amber); font-variant-numeric: tabular-nums; }
  .timer.low { color: var(--sr-red); }
  .q { position: absolute; z-index: 2; left: 50%; bottom: 1rem; transform: translateX(-50%); font-family: var(--stencil); font-size: clamp(1rem, 2.6vw, 1.5rem); letter-spacing: .08em; color: var(--sr-amber); background: rgba(28,32,22,.85); padding: .2rem .8rem; white-space: nowrap; }
  .ref { position: absolute; z-index: 2; top: .9rem; left: 1rem; font-family: 'JetBrains Mono', monospace; font-size: .78rem; color: var(--sr-tan); }

  .report { padding-block: 3rem 5rem; }
  .sheet { background: var(--sr-paper); color: #24261b; padding: clamp(1.25rem, 4vw, 2.5rem); border-radius: 3px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); position: relative; }
  .sheet::before { content: 'UNCLASSIFIED'; position: absolute; right: 1.25rem; top: 1.1rem; font-family: var(--stencil); font-size: .85rem; color: #8a3b2b; border: 2px solid #8a3b2b; padding: .1rem .5rem; transform: rotate(4deg); }
  .sheet header { display: flex; flex-wrap: wrap; gap: .25rem 1rem; align-items: baseline; border-bottom: 2px solid #24261b; padding-bottom: .75rem; margin-bottom: 1.25rem; padding-right: 8rem; }
  .sheet h2 { font-family: var(--cond); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0; }
  .sheet header span { font-family: 'JetBrains Mono', monospace; font-size: .78rem; color: #5b5a45; }
  dl { margin: 0; display: flex; flex-direction: column; }
  .line { display: grid; grid-template-columns: 3rem 10rem minmax(0, 1fr); gap: 1rem; align-items: baseline; padding-block: .85rem; border-bottom: 1px dashed rgba(36,38,27,.3); }
  dt { font-family: var(--stencil); font-size: 2rem; line-height: 1; color: #8a3b2b; }
  dd { margin: 0; font-size: 1.05rem; }
  dd.k { font-family: var(--cond); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  @media (max-width: 600px) { .line { grid-template-columns: 2.2rem minmax(0, 1fr); } dd.k { grid-column: 2; } dd:last-child { grid-column: 2; } .sheet header { padding-right: 0; padding-top: 2rem; } }

  .tiers { padding-block: 0 6rem; }
  .tier-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 680px) { .tier-grid { grid-template-columns: minmax(0, 1fr); } }
  .tier { border: 1px solid rgba(200,184,138,.4); padding: 1.75rem 2rem 2rem; border-radius: 4px; transition: border-color .3s, transform .4s var(--ease-out); }
  .tier:hover { transform: translateY(-4px); border-color: var(--sr-tan); }
  .tier.pro { border-color: var(--sr-amber); background: rgba(255,181,71,.06); }
  .tier h3 { font-family: var(--cond); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: 1.6rem; margin: 0 0 .75rem; }
  .tier.pro h3 { color: var(--sr-amber); }
  .tier ul { margin: 0 0 1.5rem; padding-left: 1.1rem; }
</style>
