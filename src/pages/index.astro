---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
import { url } from '../lib/url';

const headline = ['Games', 'and', 'tools,', 'built', 'one', 'at', 'a', 'time.'];
const ticker = ['Spotrep', 'Dust & Deputies', 'Pathfinder', 'Made in Denmark'];
---

<Base title="Tangobuilds · Games and tools from Denmark" description="Tangobuilds is an independent studio in Denmark making games and Windows tools: Spotrep, Dust & Deputies and Pathfinder.">
  <main id="main">
    <section class="hero">
      <canvas class="field" aria-hidden="true"></canvas>
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="callsign"><span class="dot"></span>T · Tango · Independent studio, Denmark</p>
        <h1 aria-label={headline.join(' ')}>
          {headline.map((w, i) => (
            <span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>
          ))}
        </h1>
        <p class="lead">A daily spotting game for military equipment, a western about holding a town till sunrise, and a Windows app that finally sorts your Downloads folder.</p>
        <div class="actions">
          <a class="btn btn-primary" href="#work" data-magnetic>See the work <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="https://www.spotrep.net" target="_blank" rel="noopener" data-magnetic>Play Spotrep <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="stack" aria-hidden="true">
        {projects.map((p, i) => (
          <div class={`stack-card s${i}`}><Cover slug={p.slug} morph={false} /></div>
        ))}
      </div>
      <a class="scroll-cue" href="#work" aria-label="Scroll to projects"><span></span></a>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => (
          <div class="run">{ticker.map((t) => <span>{t}<i>✦</i></span>)}</div>
        ))}
      </div>
    </div>

    <section id="work" class="work">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <p class="eyebrow">Selected work</p>
          <h2>Three projects, each with its own world.</h2>
        </header>

        <div class="list">
          {projects.map((p, i) => (
            <a class={`card ${i % 2 ? 'flip' : ''}`} href={url(`projects/${p.slug}/`)}>
              <div class="card-visual" data-reveal="scale" data-tilt="7">
                <Cover slug={p.slug} />
                <span class="shine" aria-hidden="true"></span>
              </div>
              <div class="card-text" data-reveal data-delay="120">
                <div class="meta">
                  <span class={`chip chip-${p.status}`}>{p.statusLabel}</span>
                  <span>{p.kind === 'game' ? 'Game' : 'Software'} · {p.platform}</span>
                </div>
                <h3>{p.name}</h3>
                <p class="tag">{p.tagline}</p>
                <p>{p.summary}</p>
                <span class="more">Explore {p.name} <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="numbers">
      <div class="wrap grid">
        <div data-reveal><b><span data-count="329">329</span></b><span>vehicles, aircraft and weapons to learn in Spotrep</span></div>
        <div data-reveal data-delay="100"><b><span data-count="20">20</span></b><span>nights in the Dust &amp; Deputies story campaign</span></div>
        <div data-reveal data-delay="200"><b>1</b><span>key press to file a download with Pathfinder</span></div>
      </div>
    </section>

    <section class="about">
      <div class="wrap about-grid">
        <div data-reveal="left">
          <p class="eyebrow">The studio</p>
          <h2>One person, a lot of builds.</h2>
        </div>
        <div data-reveal data-delay="120">
          <p>Tangobuilds is a one-person studio in Denmark run by Tobias. I make games in Unity, games for the web, and small Windows tools I wanted for myself.</p>
          <p>Every project gets its own look and its own rules. Click into one and you'll see what I mean.</p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap" data-reveal>
        <p class="eyebrow">Say hello</p>
        <h2 class="big">Let's talk.</h2>
        <div class="mail">
          <span class="addr">hello@tangobuilds.com</span>
          <button class="btn btn-ghost" type="button" data-copy="hello@tangobuilds.com">Copy address</button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter credit="Spotrep cover photo: U.S. Army (105th MPAD), public domain, via Wikimedia Commons." />
</Base>

<script>
  // Hero dot field: a grid of dots that swells and brightens near the pointer.
  function startField() {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero .field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = canvas.parentElement!;
    let w = 0, h = 0, dpr = 1, raf = 0, t = 0;
    let px = -9999, py = -9999;
    const gap = 28;

    const size = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = hero.clientWidth; h = hero.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (let y = gap / 2; y < h; y += gap) {
        for (let x = gap / 2; x < w; x += gap) {
          const d = Math.hypot(x - px, y - py);
          const near = Math.max(0, 1 - d / 220);
          const wave = reduced ? 0 : (Math.sin(x * 0.012 + t) + Math.cos(y * 0.015 + t * 0.8)) * 0.25;
          const r = 1 + near * 2.6 + wave * 0.6;
          const a = 0.12 + near * 0.75 + wave * 0.08;
          ctx.fillStyle = near > 0.05 ? `rgba(255,106,43,${a})` : `rgba(154,166,191,${a})`;
          ctx.beginPath(); ctx.arc(x, y, Math.max(0.4, r), 0, Math.PI * 2); ctx.fill();
        }
      }
    };
    const loop = () => { t += 0.012; draw(); raf = requestAnimationFrame(loop); };
    const move = (e: PointerEvent) => { const r = hero.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; if (reduced) draw(); };
    const leave = () => { px = py = -9999; if (reduced) draw(); };

    size();
    if (reduced) draw(); else loop();
    window.addEventListener('resize', size);
    hero.addEventListener('pointermove', move);
    hero.addEventListener('pointerleave', leave);
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', size);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', startField);
</script>

<style>
  .eyebrow { font-family: var(--mono); font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--tango); margin: 0 0 1rem; }

  /* Hero */
  .hero { position: relative; min-height: min(100svh, 56rem); display: flex; align-items: center; overflow: hidden; padding-block: 7rem 5rem; }
  .field { position: absolute; inset: 0; width: 100%; height: 100%; }
  .glow { position: absolute; width: 60rem; height: 60rem; right: -20rem; top: -26rem; background: radial-gradient(circle, rgba(255,106,43,.22), transparent 62%); pointer-events: none; animation: drift 14s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate(-6rem, 5rem) scale(1.1); } }
  .hero-inner { position: relative; }
  .callsign { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--mono); font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: 0 0 1.75rem; }
  .callsign .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--tango); box-shadow: 0 0 14px var(--tango); }
  h1 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3.4rem, 11vw, 9.5rem); line-height: .86; letter-spacing: -.005em; margin: 0; max-width: 11ch; }
  h1 .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .06em; margin-right: .22em; }
  h1 .w > span { display: inline-block; animation: rise 1.1s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms + 150ms); }
  h1 .w:nth-child(3) > span, h1 .w:nth-child(8) > span { color: var(--tango); }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  .lead { max-width: 38rem; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--muted); margin: 2rem 0 2.25rem; animation: fade 1s var(--ease-out) .8s both; }
  .actions { display: flex; gap: .85rem; flex-wrap: wrap; animation: fade 1s var(--ease-out) 1s both; }
  @keyframes fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .scroll-cue { position: absolute; left: 50%; bottom: 1.75rem; width: 26px; height: 42px; margin-left: -13px; border: 1.5px solid var(--muted); border-radius: 14px; opacity: .7; }
  .scroll-cue span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: var(--fg); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }

  .stack { position: absolute; right: max(2rem, calc((100vw - 76rem) / 2)); top: 50%; width: min(30vw, 26rem); aspect-ratio: 4 / 3; transform: translateY(-45%); pointer-events: none; }
  .stack-card { position: absolute; inset: 0; animation: deal 1.2s var(--ease-out) both, bob 7s ease-in-out infinite alternate; }
  .stack-card :global(.cover) { box-shadow: 0 40px 70px -30px rgba(0,0,0,.85); }
  .s0 { --r: -9deg; --x: -18%; --y: -16%; animation-delay: .5s, 1.7s; }
  .s1 { --r: 5deg; --x: 14%; --y: 4%; animation-delay: .65s, 1.9s; }
  .s2 { --r: -2deg; --x: -6%; --y: 30%; animation-delay: .8s, 2.1s; }
  .stack-card { transform: translate(var(--x), var(--y)) rotate(var(--r)); }
  @keyframes deal { from { opacity: 0; transform: translate(60%, 10%) rotate(20deg) scale(.8); } }
  @keyframes bob { to { transform: translate(var(--x), calc(var(--y) - 3%)) rotate(calc(var(--r) * .7)); } }
  @media (max-width: 1280px) { .stack { display: none; } }

  /* Ticker */
  .ticker { background: var(--tango); color: var(--ink-950); overflow: hidden; transform: rotate(-1.5deg); margin-block: -.5rem; position: relative; z-index: 2; box-shadow: 0 20px 40px -20px rgba(0,0,0,.6); }
  .track { display: flex; width: max-content; animation: marquee 32s linear infinite; }
  .run { display: flex; }
  .run span { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.6rem, 3.5vw, 2.6rem); padding: .55rem 0; white-space: nowrap; display: inline-flex; align-items: center; }
  .run i { font-style: normal; font-size: .6em; margin-inline: 1.6rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* Work */
  .work { padding-block: 8rem 4rem; }
  .section-head { margin-bottom: 4rem; max-width: 40rem; }
  h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: .95; margin: 0; text-wrap: balance; }
  .list { display: flex; flex-direction: column; gap: clamp(4rem, 9vw, 8rem); }
  .card { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; text-decoration: none; color: inherit; }
  .card.flip .card-visual { order: 2; }
  @media (max-width: 820px) { .card, .card.flip { grid-template-columns: minmax(0, 1fr); } .card.flip .card-visual { order: 0; } }
  .card-visual { position: relative; perspective: 1000px; border-radius: 18px; }
  .card-visual :global(.cover) { transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .5s var(--ease-out), box-shadow .5s; box-shadow: 0 40px 80px -40px rgba(0,0,0,.8); }
  .card:hover .card-visual :global(.cover) { box-shadow: 0 50px 100px -40px rgba(255,106,43,.35); }
  .shine { position: absolute; inset: 0; border-radius: 18px; pointer-events: none; background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.18), transparent 45%); opacity: 0; transition: opacity .4s; }
  .card:hover .shine { opacity: 1; }
  .card-text { min-width: 0; }
  .meta { display: flex; align-items: center; gap: .6rem 1rem; flex-wrap: wrap; font-family: var(--mono); font-size: .78rem; color: var(--muted); }
  h3 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: .9; margin: 1.1rem 0 .6rem; transition: color .3s; }
  .card:hover h3 { color: var(--tango); }
  .tag { font-size: 1.2rem; font-weight: 500; color: var(--fg); margin: 0 0 .75rem; }
  .card-text p { color: var(--muted); margin: 0 0 1.5rem; max-width: 34rem; }
  .card-text .tag { color: var(--fg); }
  .more { display: inline-flex; gap: .5rem; font-weight: 600; color: var(--fg); border-bottom: 2px solid var(--tango); padding-bottom: .2rem; }
  .more .arrow { transition: transform .35s var(--ease-out); }
  .card:hover .more .arrow { transform: translateX(6px); }

  /* Numbers */
  .numbers { padding-block: 4rem; border-block: 1px solid var(--line); background: var(--ink-900); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  @media (max-width: 720px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .grid div { display: flex; flex-direction: column; gap: .4rem; }
  .grid b { font-family: var(--display); font-weight: 800; font-size: clamp(3.5rem, 8vw, 5.5rem); line-height: .9; color: var(--tango); font-variant-numeric: tabular-nums; }
  .grid div > span { color: var(--muted); max-width: 18rem; }

  /* About */
  .about { padding-block: 7rem; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
  @media (max-width: 720px) { .about-grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } }
  .about p:not(.eyebrow) { color: var(--muted); font-size: 1.15rem; margin: 0 0 1.25rem; max-width: 34rem; }

  /* Contact */
  .contact { padding-block: 6rem 7rem; background: radial-gradient(ellipse at 50% 120%, rgba(255,106,43,.25), transparent 60%); text-align: center; }
  .contact .eyebrow { text-align: center; }
  .big { font-size: clamp(4rem, 14vw, 11rem); line-height: .85; }
  .mail { margin-top: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .addr { font-family: var(--mono); font-size: clamp(1rem, 2.4vw, 1.35rem); user-select: all; }
</style>
